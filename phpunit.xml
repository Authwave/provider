<?xml version="1.0"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.4/phpunit.xsd"
	bootstrap="vendor/autoload.php" colors="true"
	cacheDirectory="test/phpunit/.phpunit.cache"
	failOnWarning="true" failOnRisky="true" failOnPhpunitDeprecation="true" failOnPhpunitNotice="true">
	<testsuites>
		<testsuite name="unit"><directory>test/phpunit</directory></testsuite>
		<testsuite name="integration"><directory>test/integration</directory></testsuite>
	</testsuites>
	<source><include><directory>class</directory></include></source>
</phpunit>
