{
	"name": "authwave/provider",
	"description": "Hosted or self-hosted Authwave provider.",

	"require": {
		"php": ">=8.1",
		"phpgt/cipher": "^1.0",
		"phpgt/webengine": "^5.0",
		"league/commonmark": "^v2.3.5",
		"ext-curl": "*",
		"symfony/mailer": "^8.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.5",
		"authwave/php-client": "2022.x-dev"
	},

	"autoload": {
		"psr-4": {
			"Authwave\\": "./class"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Authwave\\Test\\": "./test/unit"
		}
	}
}
