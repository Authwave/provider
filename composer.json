{
	"name": "authwave/provider",
	"description": "Hosted or self-hosted Authwave provider.",
	"require": {
		"php": ">=8.4.1",
		"phpgt/cipher": "^1.0",
		"phpgt/webengine": "^5.1",
		"league/commonmark": "^v2.3.5",
		"ext-curl": "*",
		"symfony/mailer": "^8.0",
		"phpgt/domvalidation": "dev-master as 1.0.x-dev"
	},
	"require-dev": {
		"phpunit/phpunit": "^13.4",
		"authwave/php-client": "dev-master",
		"phpstan/phpstan": "^2.1",
		"squizlabs/php_codesniffer": "^4.0",
		"phpmd/phpmd": "^2.15",
		"behat/behat": "^3.15",
		"friends-of-behat/mink-extension": "^2.7",
		"behat/mink": "^1.13",
		"dmore/chrome-mink-driver": "^2.9",
		"dmore/behat-chrome-extension": "^1.4"
	},
	"autoload": {
		"psr-4": {
			"Authwave\\": "./class"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Authwave\\Test\\": "./test/phpunit/"
		}
	},
	"scripts": {
		"behat": [
			"Composer\\Config::disableProcessTimeout",
			"test/behat/run-behat"
		],
		"phpunit": "vendor/bin/phpunit --configuration phpunit.xml",
		"phpcs": "vendor/bin/phpcs class/ --standard=phpcs.xml",
		"phpmd": "vendor/bin/phpmd class/ text phpmd.xml",
		"phpstan": "vendor/bin/phpstan analyse --level 6 class",
		"test": [
			"@behat",
			"@phpunit",
			"@phpcs",
			"@phpmd",
			"@phpstan"
		]
	},
	"repositories": [
		{
			"type": "path",
			"url": "../../PhpGt/DomValidation",
			"options": {
				"symlink": true
			}
		}
	]
}
